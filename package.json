{
  "name": "ai-skill-evaluation-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "preview": "npm run build && concurrently -k \"node server/index.mjs\" \"vite preview --host 127.0.0.1 --port 5173\"",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.60.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
