# --- サーバー専用（Vite の VITE_ にはしない。リポジトリにコミットしない） ---
GEMINI_API_KEY=
# 任意。未設定時は shared/dars.js の DEFAULT_MODEL
GEMINI_MODEL=gemini-2.0-flash

# 本番で静的ファイルと API を同時に配信するポート
PORT=3000

# 開発時: API だけを立てるポート（Vite が /api をここにプロキシ）
API_PORT=8787

# 本番で dist + API を配信（npm start で自動 true）
# NODE_ENV=production

# リバースプロキシの後ろで動かす場合
# TRUST_PROXY=1

# インターネット公開時: 許可するブラウザの Origin（例: https://example.com）
# 未設定なら Origin チェックは行わない（レート制限のみ）
# PUBLIC_ORIGIN=https://example.com

# デバッグ時のみ API エラーの概要をサーバーログへ
# LOG_EVAL_ERRORS=1

# コンテナ等で 0.0.0.0 にバインド
# BIND_ALL=1

# Vite のプロキシ先を変える場合のみ
# VITE_API_PROXY=http://127.0.0.1:8787

# フロントの表示画面切替（既定: dars）
# VITE_APP_VARIANT=dars
# VITE_APP_VARIANT=home
