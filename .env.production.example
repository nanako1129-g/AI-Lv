# =========================
# Production Environment
# =========================
# このファイルをコピーして .env を作成し、値を設定してください。
# 例: cp .env.production.example .env

# --- 必須 ---
# Gemini API キー（サーバー専用。絶対にクライアントへ露出させない）
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY

# 公開ドメイン（Origin チェックに使用）
# 末尾スラッシュなしで設定
PUBLIC_ORIGIN=https://example.com

# --- 推奨 ---
# 本番の待受ポート
PORT=3000

# リバースプロキシ（Nginx/ALB/Cloud Run など）配下では有効化
TRUST_PROXY=1

# コンテナ等で全IFにバインドが必要な場合のみ有効化
# BIND_ALL=1

# --- 任意 ---
# 未設定時は shared/dars.js の DEFAULT_MODEL を利用
GEMINI_MODEL=gemini-2.0-flash

# 障害調査時のみ 1（通常運用は空/0推奨）
# LOG_EVAL_ERRORS=1

# 明示しなくても npm start では production になるが、
# 運用上の可読性のために必要なら残してよい
NODE_ENV=production
